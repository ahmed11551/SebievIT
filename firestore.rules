rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['name', 'contact', 'message', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() < 100
        && data.contact is string && data.contact.size() > 0 && data.contact.size() < 100
        && data.message is string && data.message.size() < 2000
        && data.createdAt == request.time;
    }

    match /leads/{leadId} {
      allow create: if isValidLead(request.resource.data);
      allow read: if false; // Only admin can read (via console or future admin panel)
    }
  }
}
